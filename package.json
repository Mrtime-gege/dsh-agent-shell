{
  "name": "dsh-agent-shell",
  "version": "0.2.1",
  "description": "Persistent, conversation-decoupled multi-shell terminal panel for DeepSeek Harness (DSH): real tmux TTYs, 11 model tools, draggable floating panel",
  "author": "Mrtime-gege <327958341+Mrtime-gege@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrtime-gege/dsh-agent-shell.git"
  },
  "homepage": "https://github.com/Mrtime-gege/dsh-agent-shell#readme",
  "bugs": {
    "url": "https://github.com/Mrtime-gege/dsh-agent-shell/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install-deps.sh",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/tmux.js && node --check lib/client.js",
    "test:client": "node scripts/test-client.mjs",
    "test:edge": "node scripts/test-edge.mjs",
    "test": "node scripts/test-pure.mjs && node scripts/test-consent.mjs && node scripts/test-client.mjs && node scripts/test-edge.mjs",
    "release:check": "node scripts/release-check.mjs",
    "leak:history": "node scripts/scan-history.mjs",
    "prepublishOnly": "npm run check && npm run release:check",
    "smoke": "node scripts/smoke.mjs",
    "test:consent": "node scripts/test-consent.mjs",
    "test:pure": "node scripts/test-pure.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "agent",
    "ai-agent",
    "terminal",
    "tmux",
    "shell",
    "persistent-shell",
    "interactive-terminal",
    "pty",
    "web-ui"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
